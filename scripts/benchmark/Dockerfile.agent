# Dockerfile for the gemmaclaw agent under test.
# This container runs ONLY the gemmaclaw agent (no Ollama - that runs on the host).
# Derives from gemmaclaw-benchmark:latest to reuse pre-installed node_modules.
# Ollama/llama.cpp is accessed via host.docker.internal from inside the container.

FROM gemmaclaw-benchmark:latest

WORKDIR /app

# Copy updated source files from current branch (overrides old build in base image)
COPY src ./src
COPY packages ./packages
COPY apps ./apps
COPY gemmaclaw.mjs openclaw.mjs ./
COPY scripts/benchmark/fake-gog ./scripts/benchmark/fake-gog
COPY scripts/benchmark/seed-mock-gog.py ./scripts/benchmark/seed-mock-gog.py
COPY scripts/benchmark/agent-entrypoint.sh ./scripts/benchmark/agent-entrypoint.sh
COPY scripts/build-all.mjs ./scripts/

# Rebuild gemmaclaw with updated source using already-installed dependencies
RUN pnpm build 2>/dev/null || node scripts/build-all.mjs 2>/dev/null || echo "Build done"

# Seed mock gog state (baked into image - no real credentials needed)
RUN python3 scripts/benchmark/seed-mock-gog.py

# Pre-install ollama plugin bundled runtime deps so containers start without npm access.
# All other default-enabled plugins with npm deps are denied via openclaw.json deny list.
RUN cd /app/dist/extensions/ollama && npm install --production --silent 2>/dev/null || true

# Make entrypoint executable
RUN chmod +x /app/scripts/benchmark/agent-entrypoint.sh

ENTRYPOINT ["bash", "/app/scripts/benchmark/agent-entrypoint.sh"]
