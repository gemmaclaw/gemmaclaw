# Dockerfile for the gemmaclaw agent under test.
# This container runs ONLY the gemmaclaw gateway with mock gog.
# Ollama/llama.cpp runs on the host (GPU access).
# The benchmark runner runs on the host and dispatches tasks here.

FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app
COPY . .
ENV GEMMACLAW_PREPARING=1
RUN pnpm install --frozen-lockfile
ENV GEMMACLAW_PREPARING=
RUN pnpm build

# Seed mock gog state
RUN python3 scripts/benchmark/seed-mock-gog.py

# Create isolated openclaw home
RUN mkdir -p /root/.openclaw

EXPOSE 3001

COPY scripts/benchmark/agent-entrypoint.sh /app/scripts/benchmark/agent-entrypoint.sh
RUN chmod +x /app/scripts/benchmark/agent-entrypoint.sh

ENTRYPOINT ["bash", "/app/scripts/benchmark/agent-entrypoint.sh"]
