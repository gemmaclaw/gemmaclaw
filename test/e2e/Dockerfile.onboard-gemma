# Dockerfile for the Gemmaclaw onboarding wizard E2E test.
#
# This image builds Gemmaclaw and exposes the CLI at /app/gemmaclaw.mjs so the
# accompanying scripts/e2e/onboard-gemma-docker.sh harness can drive the
# `gemmaclaw setup` wizard through the major flows in dry-run mode (no real
# model downloads, no real gateway start, no real GCP auth).
#
# Usage:
#   docker build -f test/e2e/Dockerfile.onboard-gemma -t gemmaclaw-onboard-e2e .
#   docker run --rm -e OPENCLAW_SETUP_DRY_RUN=1 gemmaclaw-onboard-e2e

FROM node:22-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates git lsof bsdmainutils \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

WORKDIR /app

# Copy package manifests first so dependency installation caches separately
# from source changes.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc* ./
COPY scripts/ scripts/
COPY packages/ packages/
COPY extensions/ extensions/
COPY patches/ patches/

# Workspace deps reference "openclaw" (upstream package name). The fork
# rebranded the root package to "gemmaclaw"; rename the root manifest before
# install so workspace:* refs resolve.
RUN node -e "const p=require('./package.json'); p.name='openclaw'; require('fs').writeFileSync('package.json', JSON.stringify(p, null, 2)+'\n')"

RUN pnpm install --frozen-lockfile || pnpm install

# Copy the rest of the source.
COPY . .

# Re-apply the workspace name fix after COPY . . overwrites package.json.
RUN node -e "const p=require('./package.json'); p.name='openclaw'; require('fs').writeFileSync('package.json', JSON.stringify(p, null, 2)+'\n')"

# Build the project.
RUN pnpm build

ENV OPENCLAW_HOME=/root \
    HOME=/root \
    OPENCLAW_SETUP_DRY_RUN=1 \
    PATH=/app/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Default entrypoint: run the onboarding e2e harness. Individual cases can be
# selected via positional args (see scripts/e2e/onboard-gemma-docker.sh).
ENTRYPOINT ["bash", "/app/scripts/e2e/onboard-gemma-cases.sh"]
CMD ["all"]
